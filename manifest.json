{
  "manifest_version": 3,
  "name": "BuildingReports Sidekick",
  "version": "0.1.8",
  "description": "Unofficial cleanup tools for BuildingReports inspection reports. Not affiliated with or endorsed by BuildingReports.com.",
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "BuildingReports Sidekick",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "permissions": [
    "scripting",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.buildingreports.com/*"
  ]
}
