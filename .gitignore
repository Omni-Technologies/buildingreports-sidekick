# Dependencies (none currently, but this repo has no build step - keep clean if any appear)
node_modules/

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp

# Anything that might contain real report data, credentials, or live-test
# recovery state - this project's rule is no customer names, report IDs,
# scannumbers, or credentials ever get committed. Live-test scratch data
# belongs in the session scratchpad, never in the repo, but these patterns
# are a backstop in case something like it ever lands here by mistake.
*recovery-state*
*recovery-snapshot*
*.session-state.json
credentials.json
credentials.*.json
*.env
.env*

# Editor/OS temp files
*.tmp
*.log

# Release packaging output: staging directories, produced ZIPs, and their
# checksums are all build artifacts regenerated on demand by
# `npm run release:*` from the current source tree - see RELEASING.md
# ("Should release ZIPs be committed?") for why these are intentionally
# NOT committed: they're fully reproducible from source at any tagged
# commit, and keeping binary ZIPs out of git history keeps the repo small.
releases/

# Optional Chrome Web Store API credentials (see RELEASING.md's optional
# API automation section) - never commit real values, only the example
# placeholder file.
.cws-publish.env
.cws-publish.local.*
